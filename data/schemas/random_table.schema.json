{
  "$id": "random_table.schema.json",
  "title": "A random encounter table for travel",
  "type": "object",
  "required": [
    "id",
    "map",
    "chance_day",
    "chance_night",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "map": {
      "type": "string"
    },
    "grounds": {
      "type": "array",
      "minItems": 1,
      "description": "The battle maps this table's fights play out on (story/road_grounds.gd): one picked at random each fight, never the one picked last. The table's own `map` is among them only if listed; its meetings stay on `map`, and its fights' cells are written for `map` (elsewhere the foes take the ground's foe_spots). Unset: every fight on `map`.",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "chance_day": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "chance_night": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "summary": {
      "type": "string"
    },
    "when": {
      "type": "string",
      "description": "A story condition: the table is rolled only while it holds (Travel.roll)."
    },
    "every_road": {
      "type": "boolean",
      "description": "Rolled on every road's leg the road's own table left quiet, on this table's own chance (a hunted villain's minions on whatever road the party takes). Tables go by id; the first fight or meeting wins."
    },
    "per_night": {
      "type": "boolean",
      "description": "An every_road table rolled once a night at most, at night only (the save's `_random_nights` flag)."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "weight"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "weight": {
            "type": "integer",
            "minimum": 1
          },
          "when": {
            "type": "string"
          },
          "monsters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "monster",
                "cell"
              ],
              "additionalProperties": false,
              "properties": {
                "monster": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "cell": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer"
                  }
                },
                "name": {
                  "type": "string"
                },
                "hp": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "dialogue": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "once": {
            "type": "boolean"
          },
          "surprise": {
            "enum": [
              "",
              "party",
              "enemies"
            ]
          }
        }
      }
    }
  }
}
